{
  "id": "unison-composer",
  "name": "Composer",
  "version": "1.0.0",
  "apiVersion": "1.0",
  "kind": "app",
  "origin": "https://composer.kiyoshi.dev",
  "entry": "/",
  "authors": [
    "Kodama",
    "Better Lyrics"
  ],
  "description": "The lyrics editor for Better Lyrics. Create word-synced TTML lyrics with a visual timeline, tap-to-sync, and live preview.",
  "permissions": [
    "network",
    "files",
    "appearance",
    "audio"
  ],
  "contributes": {
    "actions": [
      {
        "slot": "lyrics.browser",
        "title": {
          "en": "Open Composer",
          "de": "Composer öffnen"
        }
      },
      {
        "slot": "lyrics.missing",
        "title": {
          "en": "Write these lyrics",
          "de": "Diese Lyrics schreiben"
        }
      }
    ]
  },
  "context": {
    "track": "v"
  },
  "icon": "https://composer.kiyoshi.dev/logo.svg"
}
