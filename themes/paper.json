{
  "id": "paper",
  "title": "Paper",
  "description": "Warm off-white with ink-brown text, for reading in daylight.",
  "creators": ["KiyoshiTheDevil"],
  "version": "1.0.0",
  "mode": "light",
  "tags": ["light", "warm"],
  "tokens": {
    "--bg-base": "#f4f1ea",
    "--bg-surface": "#fbf9f4",
    "--bg-elevated": "#ece8df",
    "--bg-hover": "#e2ddd2",
    "--surface-1": "#f8f5ef",
    "--surface-2": "#efebe2",
    "--surface-3": "#e5e0d5",
    "--acrylic": "rgba(244, 241, 234, 0.88)",
    "--stroke": "rgba(58,46,32,0.10)",
    "--stroke-dim": "rgba(58,46,32,0.06)",
    "--stroke-med": "rgba(58,46,32,0.16)",
    "--border": "var(--stroke)",
    "--fill-subtle": "rgba(58,46,32,0.045)",
    "--fill-mod": "rgba(58,46,32,0.075)",
    "--fill-strong": "rgba(58,46,32,0.115)",
    "--t1": "rgba(43,34,24,0.900)",
    "--t2": "rgba(43,34,24,0.580)",
    "--t3": "rgba(43,34,24,0.400)",
    "--t4": "rgba(43,34,24,0.210)",
    "--text-primary": "var(--t1)",
    "--text-secondary": "var(--t2)",
    "--text-muted": "var(--t3)",
    "--slider-track": "#c9c1b2",
    "--scroll-thumb": "#c4bcac",
    "--scroll-thumb-dim": "#ded8cc",
    "--scroll-thumb-hover": "#948a77",
    "--status-danger": "#c0392b",
    "--status-success": "#2f6f3a",
    "--status-warning": "#a86a10",
    "--status-info": "#1f5fa8",
    "--elevation-1": "0 2px 8px rgba(58,46,32,0.10)",
    "--elevation-2": "0 4px 14px rgba(58,46,32,0.14)",
    "--elevation-3": "0 10px 24px rgba(58,46,32,0.20)",
    "--elevation-4": "0 18px 48px rgba(58,46,32,0.26)",
    "--elevation-5": "0 28px 70px rgba(58,46,32,0.32)",
    "--accent": "#b4551f"
  }
}
